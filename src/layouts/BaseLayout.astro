---
import "../styles/tokens.css";

const {
  title = "KOMAYAN | 星・AI・音楽で世界をつくる",
  description = "星読みターフ、ゲーム、そしてキャラクター・イズナの音楽と映像。AIとともに、まだない世界を形にするKOMAYANのポートフォリオ。",
  image = "/og.png",
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const socialImage = Astro.site ? new URL(image, Astro.site).toString() : image;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030814" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content="KOMAYAN" />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" type="image/png" href="/media/avatar/komayan-icon-512.png" />
    <link rel="apple-touch-icon" href="/media/avatar/apple-touch-icon.png" />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
