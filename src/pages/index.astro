---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { musicVideos, works } from "@/data/works";
---

<BaseLayout>
  <main class="site-shell">
    <section class="hero" aria-labelledby="hero-title">
      <img
        class="hero-art"
        src="/media/hero/hoshiyomi-turf.webp"
        alt=""
        width="1600"
        height="900"
        fetchpriority="high"
      />
      <div class="hero-shade" aria-hidden="true"></div>

      <div class="hero-top">
        <div class="identity">
          <img
            src="/media/avatar/komayan-space-icon.png"
            alt="コマやんのアイコン"
            width="500"
            height="500"
          />
          <span>@komatG</span>
        </div>
      </div>

      <div class="hero-copy">
        <h1 id="hero-title">KOMAYAN</h1>
        <p class="role">HORSE RACING FORECAST APP / AI CREATOR</p>
        <p class="catch">理論とデータを軸に予想する。<br />誕生日から、馬の素質と運気まで見る。</p>

        <a
          class="substack-cta"
          href="https://substack.com/@komat6"
          target="_blank"
          rel="noreferrer"
        >
          <span aria-hidden="true">📩</span>
          <strong>星読みターフの予想を読む</strong>
          <span class="cta-arrow" aria-hidden="true">↗</span>
        </a>

        <p class="beta-badge"><span aria-hidden="true"></span>β版公開中・毎週検証配信</p>

        <ul class="fields" aria-label="KOMAYANのテーマ">
          <li>HORSE RACING</li>
          <li>THEORY</li>
          <li>DATA</li>
          <li>BIRTHDAY</li>
          <li>AI</li>
          <li>MUSIC VIDEO</li>
        </ul>
      </div>
    </section>

    <section class="section turf-section" aria-labelledby="turf-title">
      <div class="section-heading">
        <h2>星読みターフ</h2>
        <span>01</span>
      </div>

      <div class="turf-panel">
        <p class="turf-kicker">RACING FORECAST APP</p>
        <h3 id="turf-title">8割は理論。誕生日から、素質と運気も見る。</h3>
        <p class="turf-lead">
          星読みターフは、データと独自理論を軸にした競馬予想アプリです。
          そこに誕生日から見る馬の素質と、レース時の運気を加えて予想します。
        </p>

        <ul class="turf-points">
          <li><strong>理論 80%</strong><span>データと独自理論を、予想の中心に置く。</span></li>
          <li><strong>素質</strong><span>誕生日から、その馬が持つ力の傾向を見る。</span></li>
          <li><strong>運気</strong><span>誕生日をもとに、レース時の流れも見る。</span></li>
        </ul>

        <div class="turf-bottom">
          <p>現在はβ版として予想と検証を無料配信中。今後、予想販売へ移行します。</p>
          <a href="https://substack.com/@komat6" target="_blank" rel="noreferrer">
            β版を無料購読する <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section mv-section" aria-labelledby="mv-title">
      <div class="section-heading">
        <h2 id="mv-title">Music Video</h2>
        <span>{String(musicVideos.length).padStart(2, "0")}</span>
      </div>

      {
        musicVideos.map((video) => (
          <article class="mv-feature">
            <div class="mv-video" style={`--mv-poster: url("${video.image}")`}>
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`}
                title={`${video.channel}「${video.title}」ミュージックビデオ`}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>

            <div class="mv-body">
              <div class="mv-intro">
                <p class="mv-status"><span aria-hidden="true" />{video.status}</p>
                <p class="mv-channel">YOUTUBE CHANNEL</p>
                <h3>{video.channel}</h3>
                <p class="mv-concept">イズナが歌い、世界を旅する。</p>
                <p class="mv-description">
                  キャラクター「イズナ」を主人公に、音楽と映像でひとつの世界を描くプロジェクト。
                  これから新しいMVを重ねていきます。
                </p>
              </div>

              <div class="mv-release">
                <div>
                  <small>1ST MUSIC VIDEO</small>
                  <strong>『{video.title}』</strong>
                  <p>{video.line}</p>
                </div>
                <div class="mv-actions">
                  <a class="mv-primary" href={video.href} target="_blank" rel="noreferrer">
                    <span aria-hidden="true">▶</span>
                    YouTubeで観る
                  </a>
                  <a class="mv-secondary" href={video.channelHref} target="_blank" rel="noreferrer">
                    チャンネルを見る <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </section>

    <section class="section works-section" aria-labelledby="works-title">
      <div class="section-heading">
        <h2 id="works-title">Works</h2>
        <span>{String(works.length).padStart(2, "0")}</span>
      </div>

      <div class="work-list">
        {
          works.map((work) => (
            <a
              class:list={["work-item", { featured: work.featured }]}
              href={work.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${work.title}を開く`}
            >
              <div class="work-media">
                <img
                  src={work.image}
                  alt={work.imageAlt}
                  width="900"
                  height="900"
                  loading={work.featured ? "eager" : "lazy"}
                />
                {work.featured && <span class="featured-label">FEATURED</span>}
              </div>
              <div class="work-copy">
                <p>{work.category}</p>
                <h3>{work.featured && <span aria-hidden="true">🏇 </span>}{work.title}</h3>
                {work.line && <span>{work.line}</span>}
              </div>
              <span class="work-end">
                {work.status && <span class="status">{work.status}</span>}
                <span class="work-arrow" aria-hidden="true">↗</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="links-title">
      <div class="section-heading">
        <h2 id="links-title">Follow</h2>
      </div>
      <div class="link-list">
        <a class="link-item newsletter-link" href="https://substack.com/@komat6" target="_blank" rel="noreferrer">
          <span class="link-icon" aria-hidden="true">✦</span>
          <span class="link-copy"><strong>Substack</strong><small>無料ニュースレター</small></span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a class="link-item youtube-link" href="https://www.youtube.com/@izuna-6" target="_blank" rel="noreferrer">
          <span class="link-icon youtube-icon" aria-hidden="true">▶</span>
          <span class="link-copy"><strong>YouTube</strong><small>量子論 イズナ</small></span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a class="link-item" href="https://x.com/komatobideepwin" target="_blank" rel="noreferrer">
          <span class="link-icon social-icon" aria-hidden="true">X</span>
          <span class="link-copy"><strong>X</strong><small>@komatobideepwin</small></span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a class="link-item" href="https://www.instagram.com/komatobi.eth/" target="_blank" rel="noreferrer">
          <span class="link-icon social-icon" aria-hidden="true">IG</span>
          <span class="link-copy"><strong>Instagram</strong><small>@komatobi.eth</small></span>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <footer>
      <p>KOMAYAN / QUANTUM THEORY IZUNA</p>
      <span>© {new Date().getFullYear()} KOMAYAN</span>
    </footer>
  </main>
</BaseLayout>

<style>
  .site-shell {
    width: min(100% - 2rem, 760px);
    margin: 0 auto;
    padding: 1rem 0 2rem;
  }

  .hero {
    position: relative;
    min-height: min(740px, calc(100svh - 2rem));
    border: 1px solid rgba(216, 180, 97, 0.25);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.48), var(--shadow-gold);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-art,
  .hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-art {
    z-index: -3;
    object-fit: cover;
    object-position: 54% center;
    transform: scale(1.015);
    animation: hero-drift 18s ease-in-out infinite alternate;
  }

  .hero-shade {
    z-index: -2;
    background:
      linear-gradient(180deg, rgba(2, 5, 13, 0.22) 0%, rgba(2, 5, 13, 0.1) 30%, rgba(2, 5, 13, 0.92) 76%, #02050d 100%),
      linear-gradient(90deg, rgba(2, 5, 13, 0.9) 0%, rgba(2, 5, 13, 0.46) 50%, rgba(2, 5, 13, 0.1) 100%);
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border: 1px solid rgba(247, 244, 233, 0.04);
    border-radius: inherit;
    pointer-events: none;
  }

  .hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
  }

  .identity {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--ink);
    font-size: 12px;
    font-weight: 700;
  }

  .identity img {
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid rgba(242, 213, 141, 0.6);
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 3px rgba(2, 5, 13, 0.48);
  }

  .hero-copy {
    position: absolute;
    left: clamp(1.25rem, 5vw, 2.75rem);
    right: clamp(1.25rem, 5vw, 2.75rem);
    bottom: clamp(1.5rem, 5vw, 2.75rem);
    width: min(100% - 2.5rem, 31rem);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.75rem, 10vw, 5.2rem);
    line-height: 0.94;
    text-wrap: balance;
  }

  .role {
    margin: 0.75rem 0 0;
    color: var(--gold-bright);
    font-size: clamp(0.92rem, 2.8vw, 1.08rem);
    font-weight: 700;
  }

  .catch {
    margin: 0.45rem 0 0;
    color: var(--ink);
    font-size: clamp(1.15rem, 4vw, 1.6rem);
    font-weight: 650;
    line-height: 1.45;
  }

  .substack-cta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: center;
    width: 100%;
    min-height: 3.7rem;
    margin-top: 1.35rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--gold-bright);
    border-radius: 6px;
    background: linear-gradient(135deg, #f2d58d 0%, #c99b3c 100%);
    box-shadow: 0 14px 40px rgba(216, 180, 97, 0.32);
    color: #10100d;
    transition: transform 180ms var(--ease), box-shadow 180ms var(--ease), filter 180ms var(--ease);
  }

  .substack-cta:hover {
    filter: brightness(1.06);
    box-shadow: 0 18px 48px rgba(216, 180, 97, 0.42);
    transform: translateY(-2px);
  }

  .substack-cta strong {
    font-size: clamp(0.9rem, 3.2vw, 1.02rem);
    text-align: center;
  }

  .cta-arrow {
    font-size: 16.3px;
  }

  .beta-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: max-content;
    max-width: 100%;
    margin: 0.8rem 0 0;
    padding: 0.35rem 0.6rem;
    border: 1px solid rgba(216, 180, 97, 0.28);
    border-radius: 999px;
    background: #10100d;
    color: rgba(247, 244, 233, 0.82);
    font-size: 12px;
    font-weight: 700;
    backdrop-filter: blur(10px);
  }

  .beta-badge span {
    width: 0.42rem;
    height: 0.42rem;
    flex: 0 0 auto;
    border-radius: 6px;
    background: var(--gold-bright);
    box-shadow: 0 0 12px rgba(242, 213, 141, 0.8);
  }

  .fields {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .fields li {
    padding: 0.28rem 0.48rem;
    border: 1px solid rgba(105, 199, 216, 0.2);
    border-radius: 6px;
    background: var(--surface);
    color: #a3cce0;
    font-size: 12px;
    font-weight: 750;
    backdrop-filter: blur(8px);
  }

  .section {
    margin-top: 3rem;
  }

  .works-section {
    scroll-margin-top: 1rem;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.8rem;
    padding: 0 0.15rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 0.8rem;
    text-transform: uppercase;
  }

  .section-heading > span {
    color: var(--gold);
    font-size: 12px;
    font-weight: 700;
  }

  .turf-section {
    scroll-margin-top: 1rem;
  }

  .turf-panel {
    padding: clamp(1.25rem, 5vw, 2rem);
    border-top: 1px solid rgba(105, 199, 216, 0.4);
    border-bottom: 1px solid rgba(105, 199, 216, 0.24);
    background:
      radial-gradient(circle at 8% 0%, rgba(105, 199, 216, 0.14), transparent 18rem),
      linear-gradient(135deg, rgba(7, 16, 31, 0.88), rgba(2, 5, 13, 0.94));
    box-shadow: 0 16px 48px rgba(105, 199, 216, 0.08);
  }

  .turf-kicker {
    margin: 0;
    color: var(--cyan);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .turf-panel h3 {
    max-width: 13em;
    margin: 0.55rem 0 0;
    font-size: clamp(1.55rem, 5vw, 2.15rem);
    line-height: 1.35;
    text-wrap: balance;
  }

  .turf-lead {
    max-width: 40rem;
    margin: 0.85rem 0 0;
    color: var(--muted);
    font-size: 14.1px;
    line-height: 1.8;
  }

  .turf-points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 1.5rem 0 0;
    padding: 0;
    border-top: 1px solid rgba(216, 180, 97, 0.2);
    border-bottom: 1px solid rgba(216, 180, 97, 0.2);
    list-style: none;
  }

  .turf-points li {
    min-width: 0;
    padding: 1rem;
  }

  .turf-points li + li {
    border-left: 1px solid rgba(216, 180, 97, 0.2);
  }

  .turf-points strong,
  .turf-points span {
    display: block;
  }

  .turf-points strong {
    color: var(--gold-bright);
    font-size: 14.1px;
  }

  .turf-points span {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 12.2px;
    line-height: 1.65;
  }

  .turf-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .turf-bottom p {
    margin: 0;
    color: var(--muted);
    font-size: 12.2px;
    line-height: 1.6;
  }

  .turf-bottom a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.8rem;
    flex: 0 0 auto;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--cyan);
    border-radius: 6px;
    background: rgba(105, 199, 216, 0.12);
    color: var(--ink);
    font-size: 14.1px;
    font-weight: 800;
    transition: background 180ms var(--ease), transform 180ms var(--ease);
  }

  .turf-bottom a:hover {
    background: rgba(105, 199, 216, 0.2);
    transform: translateY(-2px);
  }

  .turf-bottom a:focus-visible {
    outline: 2px solid var(--gold-bright);
    outline-offset: 3px;
  }

  .mv-feature {
    position: relative;
    border: 1px solid rgba(163, 204, 224, 0.25);
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 12% 0%, rgba(105, 199, 216, 0.18), transparent 19rem),
      linear-gradient(145deg, rgba(6, 13, 25, 0.96), rgba(2, 5, 13, 0.98));
    box-shadow: 0 24px 72px rgba(0, 0, 0, 0.42), var(--shadow-cyan);
    overflow: hidden;
  }

  .mv-feature::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(247, 244, 233, 0.025);
    pointer-events: none;
  }

  .mv-video {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000 var(--mv-poster) center / cover no-repeat;
    overflow: hidden;
  }

  .mv-video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .mv-body {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(15rem, 0.92fr);
    gap: 2rem;
    padding: clamp(1.25rem, 5vw, 2rem);
  }

  .mv-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.2rem;
    color: #db7d7d;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .mv-status span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 6px;
    background: #d44343;
    box-shadow: 0 0 15px rgba(208, 77, 77, 0.9);
  }

  .mv-channel,
  .mv-release small {
    margin: 0;
    color: var(--cyan);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .mv-intro h3 {
    margin: 0.35rem 0 0;
    font-family: "Yu Mincho", "Hiragino Mincho ProN", serif;
    font-size: clamp(1.85rem, 7vw, 3rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.12;
  }

  .mv-concept {
    margin: 1rem 0 0;
    color: var(--ink);
    font-family: "Yu Mincho", "Hiragino Mincho ProN", serif;
    font-size: clamp(1rem, 3.5vw, 1.25rem);
    letter-spacing: 0.03em;
  }

  .mv-description {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.8;
  }

  .mv-release {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.2rem;
    padding-left: 1.5rem;
    border-left: 1px solid rgba(105, 199, 216, 0.18);
  }

  .mv-release strong {
    display: block;
    margin-top: 0.35rem;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.5;
  }

  .mv-release p {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 12.2px;
    line-height: 1.55;
  }

  .mv-actions {
    display: grid;
    gap: 0.55rem;
  }

  .mv-primary,
  .mv-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    border-radius: 6px;
    font-size: 14.1px;
    font-weight: 800;
    transition: transform 180ms var(--ease), background 180ms var(--ease), border-color 180ms var(--ease);
  }

  .mv-primary {
    gap: 0.6rem;
    background: #d23b3b;
    color: #fff;
  }

  .mv-secondary {
    gap: 0.45rem;
    border: 1px solid rgba(247, 244, 233, 0.18);
    color: var(--ink);
  }

  .mv-primary:hover,
  .mv-secondary:hover {
    transform: translateY(-2px);
  }

  .mv-primary:hover {
    background: #e04b4b;
  }

  .mv-secondary:hover {
    border-color: rgba(105, 199, 216, 0.5);
    background: rgba(105, 199, 216, 0.08);
  }

  .mv-primary:focus-visible,
  .mv-secondary:focus-visible {
    outline: 2px solid var(--gold-bright);
    outline-offset: 3px;
  }

  .work-list,
  .link-list {
    display: grid;
    gap: 0.7rem;
  }

  .work-item,
  .link-item {
    border: 1px solid rgba(247, 244, 233, 0.11);
    border-radius: var(--radius);
    background: var(--glass);
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(14px);
  }

  .work-item {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr) auto;
    gap: 0.9rem;
    align-items: center;
    min-height: 6.6rem;
    padding: 0.75rem;
    transition: background 180ms var(--ease), border-color 180ms var(--ease), transform 180ms var(--ease);
  }

  .work-item.featured {
    grid-template-columns: minmax(12rem, 1.08fr) minmax(0, 1fr) auto;
    min-height: 12rem;
    border-color: rgba(216, 180, 97, 0.52);
    background: linear-gradient(135deg, rgba(216, 180, 97, 0.1), rgba(7, 16, 31, 0.84));
    box-shadow: var(--shadow-gold);
  }

  .work-item:hover,
  .link-item:hover {
    border-color: rgba(216, 180, 97, 0.54);
    background: rgba(216, 180, 97, 0.08);
    transform: translateY(-2px);
  }

  .work-item:focus-visible,
  .link-item:focus-visible,
  .substack-cta:focus-visible {
    outline: 2px solid var(--gold-bright);
    outline-offset: 3px;
  }

  .work-media {
    position: relative;
    width: 5rem;
    height: 5rem;
    border-radius: 6px;
    overflow: hidden;
  }

  .work-media img {
